    <!-- AI-Suggestion -->
    <string name="haru_chip_today_weather">오늘 대한민국 전체의 날씨를 요약해줘. 기온, 강수, 미세먼지 같은 주요 요소도 함께 알려줘.</string>
    <string name="haru_chip_today_news">오늘 대한민국의 주요 뉴스를 3가지로 정리해줘. 새로운 뉴스가 적다면 어제 뉴스를 대신 알려줘.</string>
    <string name="haru_chip_today_lunch">오늘 날씨와 기온을 고려해서 점심 메뉴 3가지를 추천해줘. 답변은 항상 오늘 같이 &#123;str&#125;한 날에는으로 시작해줘.</string>
    <string name="haru_chip_today_dinner">오늘 하루를 마무리하기 좋은 저녁 메뉴 3가지를 추천해줘. 따뜻한 음식과 가벼운 음식도 포함해줘.</string>
    <string name="haru_chip_today_stock">오늘 대한민국 주식 시장의 전반적인 흐름과 코스피, 코스닥 같은 주요 지수 변화를 알려줘.</string>
    <string name="haru_chip_today_exchange_rate">오늘 원화 기준으로 달러, 엔화, 유로 환율을 알려줘. 가능하다면 최근 며칠간의 추세도 설명해줘.</string>
    <string name="haru_chip_today_sports">오늘 대한민국 주요 스포츠 경기 결과를 알려줘. 만약 국내 경기가 없으면 해외축구나 MLB 같은 주요 경기 결과를 알려줘.</string>
    <string name="haru_chip_today_issue">오늘 대한민국에서 사람들이 가장 많이 주목하는 사회적 이슈를 정리해줘.</string>
    <string name="haru_chip_today_schedule">오늘 같은 날씨와 분위기에 어울리는 간단한 일상 일정이나 활동을 추천해줘.</string>
    <string name="haru_chip_today_movie">오늘 보기 좋은 최신 영화나 화제가 된 인기 영화 3편을 추천해줘.</string>
    <string name="haru_chip_today_drama">오늘 볼만한 인기 드라마나 최근 방영 중인 드라마를 3편 추천해줘.</string>
    <string name="haru_chip_today_book">오늘 읽기 좋은 책 3권을 추천해줘. 소설, 자기계발서, 교양서 등 다양하게 포함해줘.</string>
    <string name="haru_chip_today_music">오늘 분위기에 어울리는 음악 3곡을 추천해줘. 장르도 간단히 알려줘.</string>
    <string name="haru_chip_today_health_tip">오늘 실천하기 좋은 간단한 건강 관리 팁을 알려줘.</string>
    <string name="haru_chip_today_diet_tip">오늘 따라 하기 좋은 다이어트 관련 팁을 알려줘.</string>
    <string name="haru_chip_today_workout">오늘 바로 실천할 수 있는 간단한 운동 루틴을 추천해줘.</string>
    <string name="haru_chip_today_trip">오늘 날씨에 맞는 국내 여행지 2곳, 해외 여행지 1곳 총 3곳을 추천해줘. 간단한 이유도 설명해줘.</string>
    <string name="haru_chip_today_recipe">오늘 만들기 좋은 간단하고 맛있는 요리 레시피를 알려줘.</string>
    <string name="haru_chip_today_tip">오늘 생활에 도움이 되는 실용적인 생활 팁을 알려줘.</string>
    <string name="haru_chip_today_english">영어 회화 표현을 포함한 예문과 해당하는 한국식 발음까지 포함해서 2가지 알려줘. 너무 자주 쓰이는 예문이 아니여도 돼.</string>
    <string name="haru_chip_today_japanese">일본어 회화 표현을 포함한 예문과 해당하는 한국식 발음까지 포함해서 2가지 알려줘. 너무 자주 쓰이는 예문이 아니여도 돼.</string>
    <string name="haru_chip_today_chinese">중국어 회화 표현을 포함한 예문과 해당하는 한국식 발음까지 포함해서 2가지 알려줘. 너무 자주 쓰이는 예문이 아니여도 돼.</string>
    <string name="haru_chip_today_history">오늘 날짜에 실제로 일어난 중요한 역사적 사건을 알려줘.</string>
    <string name="haru_chip_today_quote">오늘 하루에 힘이 될 수 있는 짧은 명언을 알려줘. 의미도 간단히 설명해줘.</string>
    <string name="haru_chip_today_proverb">오늘 기억하면 좋은 속담 하나를 알려줘. 의미도 함께 설명해줘.</string>
    <string name="haru_chip_today_politics">오늘 대한민국 정치 분야의 주요 뉴스를 알려줘.</string>
    <string name="haru_chip_today_economy">오늘 대한민국 경제 분야의 주요 뉴스를 알려줘.</string>
    <string name="haru_chip_today_society">오늘 대한민국 사회 분야에서 중요한 뉴스를 알려줘.</string>
    <string name="haru_chip_today_international">오늘 전 세계에서 주목할 만한 국제 뉴스를 알려줘.</string>
    <string name="haru_chip_today_science">오늘 과학 분야의 새로운 소식이나 흥미로운 사실을 알려줘.</string>
    <string name="haru_chip_today_it">오늘 IT와 기술 분야에서 화제가 된 최신 뉴스를 알려줘.</string>
    <string name="haru_chip_today_environment">오늘 환경이나 기후 변화와 관련된 주요 뉴스를 알려줘.</string>
    <string name="haru_chip_today_indicator">오늘 대한민국의 주요 경제 지표(물가, 실업률, 경기지수 등)를 알려줘.</string>
    <string name="haru_chip_today_real_estate">오늘 대한민국 부동산 관련 주요 뉴스를 알려줘.</string>
    <string name="haru_chip_today_oil">오늘 국내 유가의 시세와 최근 변화를 알려줘.</string>
    <string name="haru_chip_today_gold">오늘 금 시세 변화를 알려줘. 최근 며칠간의 추세도 간단히 설명해줘.</string>
    <string name="haru_chip_today_coin">오늘 주요 가상화폐(비트코인, 이더리움)의 시세와 변화 추세를 알려줘.</string>
    <string name="haru_chip_today_fashion">오늘 기준으로 최근 1달간 유행하는 패션 트렌드를 간단히 정리해줘.</string>
    <string name="haru_chip_today_shopping">오늘 쇼핑하기 좋은 품목이나 인기 있는 아이템을 추천해줘.</string>
    <string name="haru_chip_today_traffic">오늘 현 시간대 대한민국 주요 고속도로 3가지 교통 상황을 알려줘.</string>
    <string name="haru_chip_today_fine_dust">오늘 대한민국의 미세먼지 농도와 대기질 상태를 알려줘.</string>

