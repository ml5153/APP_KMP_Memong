<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#000000">

    <!-- indicator -->
    <TextView
        android:id="@+id/tvImageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_bg_indicator"
        android:padding="4dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1 / 5" />

    <!-- 닫기 버튼 -->
    <FrameLayout
        android:id="@+id/lyClose"
        android:layout_width="@dimen/dimen_header_icone_space_padding"
        android:layout_height="@dimen/dimen_header_icone_space_padding"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/ripple_circle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_image_detail_close" />
    </FrameLayout>

    <!-- 다운로드 버튼 -->
    <FrameLayout
        android:id="@+id/lyDownload"
        android:layout_width="@dimen/dimen_header_icone_space_padding"
        android:layout_height="@dimen/dimen_header_icone_space_padding"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ripple_circle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyClose"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnDownload"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_image_detail_download" />
    </FrameLayout>

    <!-- 공유 버튼 -->
    <FrameLayout
        android:id="@+id/lyShare"
        android:layout_width="@dimen/dimen_header_icone_space_padding"
        android:layout_height="@dimen/dimen_header_icone_space_padding"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ripple_circle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyDownload"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_image_detail_share" />
    </FrameLayout>

    <!-- 삭제 버튼 -->
    <FrameLayout
        android:id="@+id/lyDelete"
        android:layout_width="@dimen/dimen_header_icone_space_padding"
        android:layout_height="@dimen/dimen_header_icone_space_padding"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ripple_circle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyShare"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_header_trash" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
