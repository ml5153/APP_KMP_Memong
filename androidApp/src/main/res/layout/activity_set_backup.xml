                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:text="@string/haru_title_manage"
                android:textColor="#000000"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/itemRestore"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/ripple_rectangle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/haru_item_title_restore"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/haru_item_desc_restore"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/restoreBtn"
                    android:layout_width="10dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemShowBackupGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_rectangle"
                android:orientation="vertical"
