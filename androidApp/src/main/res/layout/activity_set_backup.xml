                                android:layout_height="wrap_content"
                                android:text="@string/haru_item_title_gd_current_backup_date"
                                android:textColor="#1A1A1A"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/gDCurrentBackupDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/haru_exam_gd_current_backup_date"
                            android:textColor="@color/haru_primary_orange"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
