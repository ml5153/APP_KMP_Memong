                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/labelLocalBackup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/haru_item_title_local_backup"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/labelBackupPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/haru_item_locate_backup_file"
                        android:textColor="#FF2E2E"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/haru_item_desc_local_backup"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/localBackupBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_backup" />
            </LinearLayout>

