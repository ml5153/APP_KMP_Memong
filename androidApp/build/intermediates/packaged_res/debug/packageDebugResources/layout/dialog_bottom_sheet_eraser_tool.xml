<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_rounded_top_white"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/rgEraserMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEraseArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:padding="16dp"
            android:text="@string/haru_eraser_area"
            android:textColor="@color/haru_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEraseStroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="16dp"
            android:text="@string/haru_eraser_stroke"
            android:textColor="@color/haru_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEraseAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="16dp"
            android:text="@string/haru_eraser_all_memo_delete"
            android:textColor="@color/haru_black"
            android:textSize="14sp" />


        <!-- 지우개 굵기 조절 -->

        <SeekBar
            android:id="@+id/eraserSizeSeekbar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/shape_seekbar_progress"
            android:thumb="@drawable/shape_seekbar_thumb" />


    </LinearLayout>

</LinearLayout>
