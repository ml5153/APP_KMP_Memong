<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/passwordRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 헤더 -->
    <com.avatye.haru.memo.ui.custom.header.SettingHeaderView
        android:id="@+id/headerPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 입력 안내 + 도트 -->
    <LinearLayout
        android:id="@+id/passwordContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E4E8ED"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toTopOf="@id/keypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPassword">

        <TextView
            android:id="@+id/textGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/haru_input_password"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/dotIndicatorLayout"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View style="@style/PasswordDotStyle" />

            <View style="@style/PasswordDotStyle" />

            <View style="@style/PasswordDotStyle" />

            <View style="@style/PasswordDotStyle" />
        </LinearLayout>

    </LinearLayout>

    <GridLayout
        android:id="@+id/keypadContainer"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#FFFFFF"
        android:columnCount="3"
        android:useDefaultMargins="false"
        app:layout_constraintBottom_toTopOf="@+id/bottomBannerView">

        <!-- row 1 -->
        <TextView
            android:id="@+id/btn1"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_right_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_1" />

        <TextView
            android:id="@+id/btn2"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/passwrod_2" />

        <TextView
            android:id="@+id/btn3"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_left_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_3" />

        <!-- row 2 -->
        <TextView
            android:id="@+id/btn4"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_right_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_4" />

        <TextView
            android:id="@+id/btn5"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_5" />

        <TextView
            android:id="@+id/btn6"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_left_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_6" />

        <!-- row 3 -->
        <TextView
            android:id="@+id/btn7"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_right_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_7" />

        <TextView
            android:id="@+id/btn8"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_8" />

        <TextView
            android:id="@+id/btn9"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_left_bottom"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_9" />

        <!-- row 4 -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="@drawable/shape_bg_keypad_top_right" />

        <TextView
            android:id="@+id/btn0"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_left"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_0" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/KeypadButtonStyle"
            android:background="@drawable/shape_bg_keypad_left"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/password_delete"
            android:textSize="14sp" />
    </GridLayout>

    <com.avatye.adcash.view.BannerAdView
        android:id="@+id/bottomBannerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
