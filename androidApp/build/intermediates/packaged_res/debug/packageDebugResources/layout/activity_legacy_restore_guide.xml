<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/legacyRestoreGuideRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEE9E1">

    <!-- 상단 이미지 -->
    <ImageView
        android:id="@+id/imageGuide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/legacy_restore_guide_1"
        app:layout_constraintBottom_toTopOf="@id/buttonSingle"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 하단: 단일 버튼 (중앙 정렬) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonSingle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/haru_primary_orange"
        android:text="@string/haru_backup_guide_next"
        android:textColor="@android:color/white"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/bottomBannerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.avatye.adcash.view.BannerAdView
        android:id="@+id/bottomBannerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
