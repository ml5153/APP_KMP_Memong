<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lyItemEmptyContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:clickable="false"
    android:elevation="0dp"
    android:focusable="false"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">


    <!-- gridView -->
    <RelativeLayout
        android:id="@+id/lyGridItemEmpty"
        android:layout_width="120dp"
        android:layout_height="136dp"
        android:background="@drawable/ripple_rectangle_all_radius_12dp"
        android:clickable="true"
        android:focusable="true"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGridEmptyImg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plus3" />

        <TextView
            android:id="@+id/tvGridEmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ivGridEmptyImg"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="@string/haru_create_write_memo_mode_button"
            android:textSize="14sp" />

    </RelativeLayout>


    <!-- ListView -->
    <RelativeLayout
        android:id="@+id/lyListItemEmpty"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:background="@drawable/ripple_rectangle_all_radius_12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:gravity="center"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivListEmptyImg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_plus3" />

        <TextView
            android:id="@+id/tvListEmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/ivListEmptyImg"
            android:layout_centerHorizontal="true"
            android:text="@string/haru_create_write_memo_mode_button"
            android:textSize="14sp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
