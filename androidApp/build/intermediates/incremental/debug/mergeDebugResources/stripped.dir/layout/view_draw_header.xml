<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/lyBack"
            android:layout_width="@dimen/dimen_header_icone_space_padding"
            android:layout_height="@dimen/dimen_header_icone_space_padding"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="10dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_header_back" />
        </FrameLayout>

        <!-- Undo -->
        <FrameLayout
            android:id="@+id/lyUndo"
            android:layout_width="@dimen/dimen_header_icone_space_padding"
            android:layout_height="@dimen/dimen_header_icone_space_padding"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lyRedo"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnUndo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_header_draw_undo" />
        </FrameLayout>

        <!-- Redo -->
        <FrameLayout
            android:id="@+id/lyRedo"
            android:layout_width="@dimen/dimen_header_icone_space_padding"
            android:layout_height="@dimen/dimen_header_icone_space_padding"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lyConfirm"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnRedo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_header_draw_redo" />
        </FrameLayout>

        <!-- Confirm -->
        <FrameLayout
            android:id="@+id/lyConfirm"
            android:layout_width="@dimen/dimen_header_icone_space_padding"
            android:layout_height="@dimen/dimen_header_icone_space_padding"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_header_check" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- divideView: 패딩 영향 받지 않게 FrameLayout의 child로 배치 -->
    <View
        android:id="@+id/divideView"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="#E4E8ED" />
</FrameLayout>
