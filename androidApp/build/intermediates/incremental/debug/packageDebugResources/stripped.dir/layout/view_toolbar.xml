<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5F5F5">

    <FrameLayout
        android:id="@+id/lyDrawing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="6dp"
        app:layout_constraintEnd_toStartOf="@id/lyCheckbox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnDrawing"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_drawer_selector" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/lyCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyBullet"
        app:layout_constraintStart_toEndOf="@id/lyDrawing"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/btnCheckbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_editor_checkbox" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lyBullet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyGallery"
        app:layout_constraintStart_toEndOf="@id/lyCheckbox"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBullet"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_editor_bullet" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lyGallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyCamera"
        app:layout_constraintStart_toEndOf="@id/lyBullet"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dialog_gallery" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lyCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lyMemoColor"
        app:layout_constraintStart_toEndOf="@id/lyGallery"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_header_camera" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lyMemoColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@drawable/ripple_circle_normal_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lyCamera"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnMemoColor"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_editor_highlight" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
