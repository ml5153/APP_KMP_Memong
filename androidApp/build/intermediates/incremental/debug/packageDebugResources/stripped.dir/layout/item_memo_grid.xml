<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gridRootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    app:strokeColor="@color/item_stroke_color"
    app:strokeWidth="0.5dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:id="@+id/lyItemMemoGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/gridLayoutBF"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/ripple_rectangle"
            android:orientation="vertical">

            <!-- Body -->
            <LinearLayout
                android:id="@+id/gridLayoutBody"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/gridTvBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:padding="3dp"
                        android:text="미리보기 텍스트입니다."
                        android:textColor="@android:color/black"
                        android:textSize="10sp"
                        android:visibility="visible" />


                    <ImageView
                        android:id="@+id/gridImgBody"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:visibility="visible"
                        tools:src="@drawable/ic_item_sample_image"
                        tools:visibility="gone" />

                    <ImageView
                        android:id="@+id/gridImgLock"
                        android:layout_width="16dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="44dp"
                        android:src="@drawable/ic_item_lock"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>


            </LinearLayout>


            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/grid_tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="2025.07.03"
                    android:textColor="#888888"
                    android:textSize="8sp" />


                <RelativeLayout
                    android:id="@+id/lyGridFooterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="end"
                    android:visibility="visible">

                    <!-- 즐겨찾기 -->
                    <FrameLayout
                        android:id="@+id/lyGridImgImportant"
                        android:layout_width="18dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:visibility="visible"
                        tools:background="@color/bg_pink">

                        <ImageView
                            android:id="@+id/grid_imgImportant"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_important_selector" />
                    </FrameLayout>

                    <!-- 드래그 -->
                    <FrameLayout
                        android:id="@+id/gridDragContainer"
                        android:layout_width="18dp"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@+id/lyGridImgImportant"
                        android:visibility="gone"
                        android:layout_marginEnd="3dp"
                        android:layout_centerVertical="true"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/gridDrag"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_item_drag" />
                    </FrameLayout>

                    <!-- 체크박스 -->
                    <FrameLayout
                        android:id="@+id/gridCheckboxContainer"
                        android:layout_width="18dp"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@+id/lyGridImgImportant"
                        android:visibility="gone"
                        android:layout_marginEnd="3dp"
                        android:layout_centerVertical="true"
                        tools:visibility="visible">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/gridCheckbox"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="1dp"
                            android:layout_marginStart="0.5dp"
                            android:background="@null"
                            android:button="@drawable/selector_item_checkbox" />
                    </FrameLayout>

                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
