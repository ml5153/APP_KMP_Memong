<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockScreenMemoRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_rounded_top_lock_screen"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/lyBack"
            android:layout_width="@dimen/dimen_header_icone_space_padding"
            android:layout_height="@dimen/dimen_header_icone_space_padding"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="10dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_header_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/haru_lock_screen_memo_list"
            android:textColor="#000000"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 메모 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMemoList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical" />
</LinearLayout>
